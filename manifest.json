{
  "manifest_version": 3,
  "name": "Site Security Inspector",
  "version": "1.0.0",
  "description": "Audits the current site for security headers, cookie flags, granted permissions, mixed content, and known-vulnerable JS libraries.",
  "permissions": ["activeTab", "cookies", "scripting", "webRequest", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Site Security Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
